{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Shared projects in the Commons, the shops among them (SPEC §8.5–8.6)",
  "type": "object",
  "additionalProperties": false,
  "required": ["projects"],
  "properties": {
    "projects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "cost", "tiers", "text"],
        "properties": {
          "id": { "$ref": "defs.schema.json#/definitions/id" },
          "name": { "type": "string", "minLength": 1 },
          "cost": { "enum": ["cheap", "standard", "expensive"], "description": "The House-building cost class it is priced from (× tuning commons.costMult)." },
          "tiers": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "enum": [1, 2, 3] }, "description": "One entry per level: the building tier each level is priced as." },
          "requires": { "$ref": "defs.schema.json#/definitions/id", "description": "A project that must stand first (the shops need the Great Market)." },
          "text": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
