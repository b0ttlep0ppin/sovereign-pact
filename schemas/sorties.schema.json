{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sorties: the short gambit forays for Scions not on the expedition (SPEC §6.11)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sorties"
  ],
  "properties": {
    "sorties": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "text",
          "pool",
          "battles",
          "xp",
          "jp",
          "rolls"
        ],
        "properties": {
          "id": {
            "$ref": "defs.schema.json#/definitions/id"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "pool": {
            "$ref": "defs.schema.json#/definitions/id",
            "description": "The enemy pool its battles are drawn from."
          },
          "battles": {
            "enum": [
              1,
              2
            ]
          },
          "xp": {
            "type": "integer",
            "minimum": 0,
            "description": "XP for each Scion, per battle won."
          },
          "jp": {
            "type": "integer",
            "minimum": 0,
            "description": "JP for each Scion if the Sortie is won."
          },
          "rolls": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3,
            "description": "Rolls on the pool's drop table per battle won, to the House."
          },
          "gold": {
            "type": "integer",
            "minimum": 0,
            "description": "Gold to the House if the Sortie is won."
          },
          "score": {
            "type": "object",
            "additionalProperties": false,
            "patternProperties": {
              "^(lineage|valor|treasury|holdings|lore|renown|intrigue|relics)$": {
                "type": "integer"
              }
            }
          }
        }
      }
    }
  }
}
