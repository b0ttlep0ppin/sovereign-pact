{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Item bases: weapon types, shields, armor by slot and class, accessories (SPEC §13.1–13.3)",
  "type": "object",
  "additionalProperties": false,
  "required": ["bases"],
  "properties": { "bases": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/base" } } },
  "definitions": {
    "location": { "enum": ["head", "body", "arms", "legs"] },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "slot", "type"],
      "properties": {
        "id": { "$ref": "defs.schema.json#/definitions/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 32 },
        "slot": { "enum": ["main", "off", "head", "body", "arms", "legs", "acc"] },
        "type": {
          "enum": ["sword", "axe", "mace", "spear", "knife", "knuckles", "bow", "crossbow", "thrown", "staff", "instrument", "shield", "armor", "accessory"]
        },
        "hands": { "enum": [1, 2] },
        "power": { "type": "number", "minimum": 0, "description": "Power index: 100 is a sword (§13.2); scaled by item level" },
        "acc": { "type": "number", "minimum": 0, "maximum": 120 },
        "crit": { "type": "number", "minimum": 0, "maximum": 50 },
        "reach": { "enum": ["melee", "reach", "ranged"] },
        "aims": { "type": "array", "items": { "$ref": "#/definitions/location" }, "description": "Locations its aimed shots favor" },
        "critStatus": { "$ref": "defs.schema.json#/definitions/id" },
        "armorPierce": { "type": "number", "minimum": 0, "maximum": 100 },
        "tpGain": { "type": "number" },
        "attackCost": { "type": "integer", "minimum": 10, "maximum": 200 },
        "spellPct": { "type": "number" },
        "mpPct": { "type": "number" },
        "guard": { "type": "number", "minimum": 0, "maximum": 100 },
        "weight": { "type": "integer", "minimum": 0, "maximum": 10 },
        "armor": { "enum": ["light", "medium", "heavy"] }
      }
    }
  }
}
