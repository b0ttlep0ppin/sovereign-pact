{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Enemy variants: the standard families an enemy can wear (SPEC §14.10)",
  "type": "object",
  "additionalProperties": false,
  "required": ["variants"],
  "properties": {
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "family", "prefix", "tint"],
        "properties": {
          "id": { "$ref": "defs.schema.json#/definitions/id" },
          "family": { "enum": ["elemental", "hollow", "unknown"], "description": "Elemental ones an enemy declares; Hollow fits any living fodder or bruiser; Unknown-touched anyone from its Year" },
          "prefix": { "type": "string", "minLength": 1 },
          "tint": { "$ref": "defs.schema.json#/definitions/hex" },
          "affinity": { "$ref": "enemies.schema.json#/properties/affinity", "description": "Added to the enemy's, then clamped" },
          "tags": { "$ref": "enemies.schema.json#/properties/tags" },
          "element": { "enum": ["holy", "dark", "fire", "water", "earth", "wind"], "description": "Given to its damaging abilities that have no element" },
          "sanityTouch": { "type": "number", "minimum": 0 },
          "level": { "type": "integer", "minimum": 0, "maximum": 3, "description": "Levels above the encounter's" },
          "roles": { "type": "array", "items": { "$ref": "enemies.schema.json#/properties/role" } },
          "immune": { "$ref": "enemies.schema.json#/properties/immune" },
          "minYear": { "type": "integer", "minimum": 1, "maximum": 20 }
        }
      }
    }
  }
}
