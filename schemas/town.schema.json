{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "A town event, drawn in the Omens step: settlement-wide or for one House; a Crisis is one decided by pledges (SPEC \u00a73.5, \u00a78.8)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "scope",
    "weight",
    "years",
    "title",
    "text",
    "rule"
  ],
  "properties": {
    "id": {
      "$ref": "defs.schema.json#/definitions/id"
    },
    "scope": {
      "enum": [
        "settlement",
        "house"
      ]
    },
    "weight": {
      "type": "integer",
      "minimum": 1
    },
    "years": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 20
      },
      "description": "The Years of a 20-Year campaign it may be drawn in; a Short campaign doubles its Year to look up."
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^!?(flag|built|building):[a-z][a-z0-9_]*$"
      }
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "rule": {
      "type": "string",
      "pattern": "^(pledges|vote|most_gold|least_gold|least_grain|most_scions|random_house|led_last|each_house|secret|house|tarot:[a-z_]+|house:trait:[a-z_]+)$"
    },
    "crisis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "need",
        "triumph",
        "holds",
        "falters",
        "calamity"
      ],
      "properties": {
        "need": {
          "$ref": "#/definitions/resources"
        },
        "temptation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "text",
            "penalty",
            "effects"
          ],
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1
            },
            "text": {
              "type": "string",
              "minLength": 1
            },
            "penalty": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "description": "Points the Crisis result loses when a House gives in to it."
            },
            "effects": {
              "$ref": "#/definitions/effects"
            }
          }
        },
        "triumph": {
          "$ref": "#/definitions/band"
        },
        "holds": {
          "$ref": "#/definitions/band"
        },
        "falters": {
          "$ref": "#/definitions/band"
        },
        "calamity": {
          "$ref": "#/definitions/band"
        }
      }
    },
    "options": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "outcomes"
        ],
        "properties": {
          "id": {
            "$ref": "defs.schema.json#/definitions/id"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "tags": {
            "type": "array",
            "items": {
              "enum": [
                "bold",
                "cautious",
                "clever",
                "reckless",
                "cruel",
                "kind"
              ]
            },
            "description": "For balancing the pool by script (SPEC \u00a79.5); the cautious bot prefers cautious options."
          },
          "outcomes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "w",
                "text",
                "effects"
              ],
              "properties": {
                "w": {
                  "type": "integer",
                  "minimum": 1
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "effects": {
                  "$ref": "#/definitions/effects"
                },
                "when": {
                  "enum": [
                    "pass",
                    "fail"
                  ],
                  "description": "For a champion's option: whether this outcome follows a pass or a fail."
                }
              }
            }
          },
          "cost": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "resources": {
                "$ref": "#/definitions/resources"
              },
              "recruits": {
                "type": "integer",
                "minimum": 1
              }
            },
            "description": "Paid in full when chosen; the option is offered only to a House that can pay."
          },
          "target": {
            "const": true,
            "description": "The chooser names another House, whom to:target, gift and ward_swap effects touch."
          },
          "accuse": {
            "const": true,
            "description": "The chooser names the House it blames; the event's blamed band falls on the House most named (none on a tie)."
          },
          "champion": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stat",
              "dc"
            ],
            "properties": {
              "stat": {
                "enum": [
                  "might",
                  "resilience",
                  "guile",
                  "acuity",
                  "sagacity",
                  "speed"
                ]
              },
              "dc": {
                "type": "integer",
                "minimum": 1,
                "maximum": 60
              }
            },
            "description": "The House puts a Scion forward, tested on the stat plus half their level against dc; outcomes with when pass or fail."
          },
          "bid": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "resource"
            ],
            "properties": {
              "resource": {
                "$ref": "defs.schema.json#/definitions/id"
              },
              "min": {
                "type": "integer",
                "minimum": 1
              }
            },
            "description": "A sealed bid, paid whether or not it wins; the highest wins the event's prize."
          }
        }
      }
    },
    "together": {
      "type": "array",
      "description": "Secret choices: what happens when no House, or every House, picks an option.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "when",
          "option",
          "text",
          "effects"
        ],
        "properties": {
          "when": {
            "enum": [
              "none",
              "all"
            ]
          },
          "option": {
            "$ref": "defs.schema.json#/definitions/id"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "effects": {
            "$ref": "#/definitions/effects"
          }
        }
      }
    },
    "forces": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pool"
      ],
      "properties": {
        "pool": {
          "$ref": "defs.schema.json#/definitions/id",
          "description": "The enemy pool of the forced card."
        },
        "size": {
          "enum": [
            4,
            8
          ]
        }
      },
      "description": "A forcing event (SPEC \u00a73.2): it comes only from the timeline, foreshadowed a Year ahead, and the Rift Gate then offers only its card, a forced expedition at the Year's band."
    },
    "prize": {
      "$ref": "#/definitions/band",
      "description": "What the highest bid wins."
    },
    "blamed": {
      "$ref": "#/definitions/band",
      "description": "What falls on the House most named by accusing options."
    }
  },
  "definitions": {
    "resources": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "integer"
      },
      "propertyNames": {
        "$ref": "defs.schema.json#/definitions/id"
      }
    },
    "band": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "effects"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "effects": {
          "$ref": "#/definitions/effects"
        }
      }
    },
    "effects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "to": {
            "enum": [
              "house",
              "all",
              "random",
              "commons",
              "target"
            ],
            "description": "Whom it touches: the subject House (default), each House, one random House, the Commons (resources only), or the House the chooser named (an option with target)."
          },
          "accord": {
            "type": "integer"
          },
          "doom": {
            "type": "integer"
          },
          "resources": {
            "$ref": "#/definitions/resources"
          },
          "ruin": {
            "type": "integer",
            "minimum": 1,
            "description": "Building levels lost, each in a random House (or the target's)."
          },
          "recruits_lost": {
            "type": "integer",
            "minimum": 1
          },
          "sanity": {
            "type": "integer",
            "description": "% of max Sanity, to every Scion and Retired of the target."
          },
          "score": {
            "type": "object",
            "additionalProperties": {
              "type": "integer"
            }
          },
          "flag": {
            "$ref": "defs.schema.json#/definitions/id"
          },
          "timeline": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "event",
              "years"
            ],
            "properties": {
              "event": {
                "$ref": "defs.schema.json#/definitions/id"
              },
              "years": {
                "type": "integer",
                "minimum": 1
              },
              "hidden": {
                "type": "boolean"
              }
            }
          },
          "recruit_gain": {
            "type": "integer",
            "minimum": 1,
            "description": "New recruits for the target House."
          },
          "scion": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "description": "One Scion (or Retired) of each House touched, and what befalls them.",
            "properties": {
              "who": {
                "type": "string",
                "pattern": "^(champion|random|eldest|youngest|veteran|greenest|sanest|maddest|(highest|lowest):(might|resilience|guile|acuity|sagacity|speed))$"
              },
              "age": {
                "type": "integer",
                "description": "Years added, or taken away."
              },
              "sanity": {
                "$ref": "expedition.schema.json#/definitions/effect/properties/sanity"
              },
              "xp": {
                "$ref": "expedition.schema.json#/definitions/effect/properties/xp"
              },
              "jp": {
                "$ref": "expedition.schema.json#/definitions/effect/properties/jp"
              },
              "injury": {
                "$ref": "expedition.schema.json#/definitions/effect/properties/injury"
              },
              "stat": {
                "$ref": "expedition.schema.json#/definitions/effect/properties/stat"
              },
              "growth": {
                "$ref": "expedition.schema.json#/definitions/effect/properties/growth"
              },
              "trait": {
                "$ref": "expedition.schema.json#/definitions/effect/properties/trait"
              },
              "curse": {
                "$ref": "expedition.schema.json#/definitions/effect/properties/curse"
              },
              "tarot": {
                "$ref": "expedition.schema.json#/definitions/effect/properties/tarot"
              },
              "blessing": {
                "$ref": "expedition.schema.json#/definitions/effect/properties/blessing"
              },
              "change": {
                "$ref": "expedition.schema.json#/definitions/effect/properties/change"
              },
              "mend": {
                "$ref": "expedition.schema.json#/definitions/effect/properties/mend"
              },
              "count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4,
                "description": "How many of the House's own it falls on."
              }
            }
          },
          "item": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "tier": {
                "enum": [
                  2,
                  3,
                  4,
                  5
                ]
              },
              "named": {
                "$ref": "defs.schema.json#/definitions/id"
              }
            },
            "description": "An item for the House: a named one if not yet made this campaign, else one rolled at the tier (default 3)."
          },
          "consumable": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "$ref": "defs.schema.json#/definitions/id"
              },
              "n": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "house_trait": {
            "type": "string",
            "pattern": "^[+-][a-z][a-z0-9_]*$",
            "description": "+id marks the House with a House trait (usually a mark), -id lifts one."
          },
          "raze": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "description": "A building torn down entirely: by id, or best (the House's highest)."
          },
          "raise": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "description": "A building raised a level, or built at level 1: by id, or any."
          },
          "gift": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "description": "A level of a building (by id, or best) passes from the subject House to the named House."
          },
          "ward_swap": {
            "const": true,
            "description": "The subject House and the named House exchange their youngest Scions as Wards."
          }
        }
      }
    }
  },
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "crisis": true
      },
      "required": [
        "crisis"
      ]
    },
    {
      "type": "object",
      "properties": {
        "options": true
      },
      "required": [
        "options"
      ]
    }
  ]
}
