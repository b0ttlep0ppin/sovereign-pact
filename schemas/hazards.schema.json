{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Battle hazards: entities without turns that trigger on a condition (SPEC §14.8)",
  "type": "object",
  "additionalProperties": false,
  "required": ["hazards"],
  "properties": {
    "hazards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "side", "weight", "trigger", "lore"],
        "properties": {
          "id": { "$ref": "defs.schema.json#/definitions/id" },
          "name": { "type": "string", "minLength": 1 },
          "side": { "enum": ["enemy", "party"], "description": "Enemy-side hazards stand on a cell and can be struck; party-side ones lie on the Scions' grid" },
          "cols": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 0, "maximum": 2 }, "description": "Enemy columns it may stand in (E1 = 0)" },
          "hp": { "type": "number", "minimum": 0, "description": "× the HP block at the level; 0: any damage destroys it" },
          "weight": { "type": "integer", "minimum": 0 },
          "pools": { "type": "array", "items": { "$ref": "defs.schema.json#/definitions/id" }, "description": "Only these pools draw it" },
          "bait": { "type": "boolean", "description": "Striking it is a mistake: bots leave it alone" },
          "hidden": { "type": "boolean", "description": "The players do not see where it lies" },
          "telegraph": { "type": "boolean" },
          "trigger": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind"],
            "properties": {
              "kind": { "enum": ["destroyed", "every", "struck_or_timer", "front_row", "timer", "enter"] },
              "ticks": { "type": "integer", "minimum": 10 }
            }
          },
          "effect": { "$ref": "enemies.schema.json#/definitions/ability" },
          "reinforce": { "type": "integer", "minimum": 1, "maximum": 4, "description": "Fodder of the pool called as a Reinforcements wave at E3" },
          "lore": { "type": "string" }
        }
      }
    }
  }
}
