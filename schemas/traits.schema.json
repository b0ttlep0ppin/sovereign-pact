{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Individual traits: one Scion's own (SPEC §6.7)",
  "type": "object",
  "additionalProperties": false,
  "required": ["traits"],
  "properties": {
    "traits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "flavor", "crunch", "weight"],
        "properties": {
          "id": { "$ref": "defs.schema.json#/definitions/id" },
          "name": { "type": "string", "minLength": 1, "maxLength": 32 },
          "flavor": { "type": "string", "minLength": 1 },
          "crunch": { "type": "string", "minLength": 1 },
          "mods": { "type": "object", "additionalProperties": { "type": "number" } },
          "tags": { "type": "array", "uniqueItems": true, "items": { "$ref": "defs.schema.json#/definitions/id" } },
          "weight": { "type": "integer", "minimum": 0, "description": "Odds at generation; 0 is never rolled (gained from events, injuries, Curses)" },
          "group": { "$ref": "defs.schema.json#/definitions/id", "description": "At most one trait of a group per person (Fleet or Sluggish)" },
          "element": { "enum": ["holy", "dark", "fire", "water", "earth", "wind"], "description": "Rolled more often for a House aligned with it (§5.6)" }
        }
      }
    }
  }
}
