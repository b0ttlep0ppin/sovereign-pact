{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Names for generated recruits and Random Houses (SPEC §5.1, §6.3)",
  "type": "object",
  "additionalProperties": false,
  "required": ["given", "houses", "mottos"],
  "properties": {
    "given": {
      "type": "object",
      "additionalProperties": false,
      "required": ["f", "m"],
      "properties": {
        "f": { "$ref": "defs.schema.json#/definitions/names" },
        "m": { "$ref": "defs.schema.json#/definitions/names" }
      }
    },
    "houses": { "type": "array", "allOf": [{ "$ref": "defs.schema.json#/definitions/names" }], "minItems": 4 },
    "mottos": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "maxLength": 60 } }
  }
}
