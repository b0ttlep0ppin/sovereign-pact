{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sprites: which pack picture each enemy, boss, summon and hazard is drawn with (SPEC §14.11, §17)",
  "type": "object",
  "additionalProperties": false,
  "required": ["sprites"],
  "properties": {
    "sprites": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source", "flip"],
        "properties": {
          "id": { "$ref": "defs.schema.json#/definitions/id" },
          "source": { "type": "string", "pattern": "^Mega Pack [12]/.+\\.png$" },
          "flip": { "type": "boolean" },
          "tweak": {
            "description": "The owner's colour tweak from the Bestiary, baked in by tools/cut-monsters.py: hue in degrees, the rest in percent",
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "hue": { "type": "integer", "minimum": -180, "maximum": 180 },
              "sat": { "type": "integer", "minimum": 0, "maximum": 300 },
              "bright": { "type": "integer", "minimum": 0, "maximum": 300 },
              "contrast": { "type": "integer", "minimum": 0, "maximum": 300 },
              "warmth": { "type": "integer", "minimum": 0, "maximum": 100 }
            }
          }
        }
      }
    }
  }
}
