{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Hunt quarries (SPEC §14.9): a named enemy of a pool with a title, an extra trick and a trophy",
  "type": "object",
  "additionalProperties": false,
  "required": ["quarries"],
  "properties": {
    "quarries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "enemy", "ability", "trophy", "text"],
        "properties": {
          "id": { "$ref": "defs.schema.json#/definitions/id" },
          "title": { "type": "string", "minLength": 1, "maxLength": 48 },
          "enemy": { "$ref": "defs.schema.json#/definitions/id", "description": "The enemy it is: its pool and levels are the quarry's" },
          "ability": { "enum": ["enrage", "ambush", "call_pack"], "description": "Enrage: starts enraged. Ambush: its lair opens with an ambush. Call the Pack: more kin in its lair" },
          "trophy": {
            "type": "object",
            "additionalProperties": false,
            "required": ["valor"],
            "properties": {
              "valor": { "type": "integer", "minimum": 1, "description": "Valor for each House in the party" },
              "stores": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 }, "description": "Into the haul" }
            }
          },
          "text": { "type": "string", "minLength": 1, "maxLength": 200 }
        }
      }
    }
  }
}
