{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sound cues: which BOOM Library file each battle cue's takes are cut from (SPEC §16.1, §17)",
  "type": "object",
  "additionalProperties": false,
  "required": ["cues"],
  "properties": {
    "cues": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source", "takes", "max"],
        "properties": {
          "id": { "$ref": "defs.schema.json#/definitions/id" },
          "source": { "type": "string", "pattern": "^((Medieval Weapons|Close Combat|Creature Foley|Magic|Magic - Arcane Forces|Free Sounds - Death Whistle)( - (Designed|Construction Kit))?/.+\\.wav|synth:dice)$" },
          "takes": { "type": "integer", "minimum": 1, "maximum": 4 },
          "max": { "type": "number", "exclusiveMinimum": 0, "maximum": 4 }
        }
      }
    }
  }
}
