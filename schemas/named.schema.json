{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Named items (SPEC §13.4, HANDOFF §6): fixed properties on a base, found once a campaign; artifacts also score a category (§3.4)",
  "type": "object",
  "additionalProperties": false,
  "required": ["named"],
  "properties": {
    "named": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "base", "tier", "props", "text"],
        "properties": {
          "id": { "$ref": "defs.schema.json#/definitions/id" },
          "name": { "type": "string", "minLength": 1, "maxLength": 40 },
          "base": { "$ref": "defs.schema.json#/definitions/id", "description": "An item base in items.json" },
          "tier": { "enum": [3, 4, 5], "description": "Fine, Masterwork or Relic" },
          "props": {
            "type": "array",
            "items": { "type": "array", "minItems": 2, "maxItems": 2, "items": [{ "$ref": "defs.schema.json#/definitions/id" }, { "type": "integer", "minimum": 1 }] }
          },
          "text": { "type": "string", "minLength": 1, "maxLength": 200 },
          "boss": { "$ref": "defs.schema.json#/definitions/id", "description": "Dropped by this boss the first time it falls" },
          "pools": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "defs.schema.json#/definitions/id" }, "description": "Found in these pools' Caches and boss hauls" },
          "minLevel": { "type": "integer", "minimum": 1, "maximum": 10 },
          "artifact": {
            "type": "object",
            "additionalProperties": false,
            "required": ["category", "points"],
            "properties": {
              "category": { "enum": ["lineage", "valor", "treasury", "holdings", "lore", "renown", "intrigue", "relics"] },
              "points": { "type": "integer", "minimum": 1 }
            },
            "description": "A House-score artifact: whoever holds it at the end scores the points (§9.10)"
          },
          "cure": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "injuries": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "defs.schema.json#/definitions/id" }, "description": "Injury results it mends" },
              "band": { "enum": ["moderate"], "description": "Or any lasting result of this band" },
              "look": { "$ref": "defs.schema.json#/definitions/id", "description": "A look it leaves on the mended" }
            },
            "description": "A cure item (§11.2): one use, made as often as it is found"
          }
        }
      }
    }
  }
}
