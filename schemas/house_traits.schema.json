{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "House traits: Major, Minor, Flaws and Bloodlines (SPEC §5.3, §5.7)",
  "type": "object",
  "additionalProperties": false,
  "required": ["traits"],
  "definitions": {
    "numbers": { "type": "object", "additionalProperties": { "type": "number" } }
  },
  "properties": {
    "traits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "kind", "flavor", "crunch"],
        "properties": {
          "id": { "$ref": "defs.schema.json#/definitions/id" },
          "name": { "type": "string", "minLength": 1, "maxLength": 32 },
          "kind": { "enum": ["major", "minor", "major_flaw", "minor_flaw", "bloodline", "mark"] },
          "flavor": { "type": "string", "minLength": 1, "description": "Shown in Flavor Mode (§5.2)" },
          "crunch": { "type": "string", "minLength": 1, "description": "The exact effect, shown in Crunch Mode" },
          "mods": { "$ref": "#/definitions/numbers", "description": "Battle mods every person of the House carries (combat/build.ts keys)" },
          "growth": {
            "type": "object",
            "additionalProperties": false,
            "description": "Recruit growth rate, in % of the rolled rate; `all` is every stat but Speed",
            "properties": {
              "might": { "type": "number" }, "resilience": { "type": "number" }, "guile": { "type": "number" },
              "acuity": { "type": "number" }, "sagacity": { "type": "number" }, "all": { "type": "number" }
            }
          },
          "jobXp": { "$ref": "#/definitions/numbers", "description": "XP rate in % per Job" },
          "economy": { "$ref": "#/definitions/numbers", "description": "Town and economy knobs, read by the systems that own them" },
          "score": { "$ref": "#/definitions/numbers", "description": "Score category gains, in %" },
          "innate": { "$ref": "#/definitions/numbers", "description": "Chance in % that a recruit rolls this individual trait" },
          "tags": { "type": "array", "uniqueItems": true, "items": { "$ref": "defs.schema.json#/definitions/id" }, "description": "Event tags (§5.3), and effects that wait on a later system" },
          "look": { "type": "array", "uniqueItems": true, "items": { "$ref": "defs.schema.json#/definitions/id" }, "description": "Appearance weights for the sprite generator (§5.8)" },
          "choice": { "enum": ["element"], "description": "The House picks something when taking the trait" }
        }
      }
    }
  }
}
