{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "A Job's ability set (SPEC §12.4–12.17): actives and purchasable passives, with JP costs",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "job",
    "actives",
    "passives"
  ],
  "properties": {
    "job": {
      "$ref": "defs.schema.json#/definitions/id"
    },
    "actives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/active"
      }
    },
    "passives": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/passive"
      }
    }
  },
  "definitions": {
    "location": {
      "enum": [
        "head",
        "body",
        "arms",
        "legs"
      ]
    },
    "active": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "jp",
        "text",
        "shape",
        "side",
        "power"
      ],
      "properties": {
        "id": {
          "$ref": "defs.schema.json#/definitions/id"
        },
        "shape": {
          "type": "string",
          "pattern": "^(single|row|column(:[FMB])?|band:[1-8]|lob|line:[1-3]|cross|burst:(3x3|5x5)|checker:[ab]|front_each_row|nearest:[1-9]|random:[1-9]|all|self|adjacent|ring)$"
        },
        "side": {
          "enum": [
            "foe",
            "ally",
            "self"
          ],
          "description": "From the user's point of view"
        },
        "power": {
          "type": "number",
          "minimum": 0
        },
        "base": {
          "type": "number",
          "minimum": 0
        },
        "kind": {
          "enum": [
            "physical",
            "magic",
            "heal",
            "support"
          ]
        },
        "element": {
          "enum": [
            "holy",
            "dark",
            "fire",
            "water",
            "earth",
            "wind",
            null
          ]
        },
        "reach": {
          "enum": [
            "melee",
            "reach",
            "ranged"
          ]
        },
        "locationBias": {
          "$ref": "#/definitions/location"
        },
        "cost": {
          "type": "integer",
          "minimum": 10,
          "maximum": 200
        },
        "charge": {
          "type": "integer",
          "minimum": 0,
          "description": "Ticks before Acuity"
        },
        "telegraph": {
          "type": "boolean"
        },
        "homing": {
          "type": "boolean"
        },
        "cooldown": {
          "type": "integer",
          "minimum": 0
        },
        "sanity": {
          "type": "number",
          "minimum": 0
        },
        "readiness": {
          "type": "number",
          "minimum": 0
        },
        "hits": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "accuracy": {
          "type": "number"
        },
        "crit": {
          "type": "number"
        },
        "statuses": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "chance",
              "ticks"
            ],
            "properties": {
              "id": {
                "$ref": "defs.schema.json#/definitions/id"
              },
              "chance": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "ticks": {
                "type": "integer",
                "minimum": 0
              },
              "value": {
                "type": "number"
              },
              "tag": {
                "type": "string",
                "description": "Only on targets with this tag"
              },
              "mods": {
                "type": "object",
                "additionalProperties": {
                  "type": "number"
                },
                "description": "Mods the status adds while it lasts"
              }
            }
          }
        },
        "aim": {
          "$ref": "#/definitions/location"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "jp": {
          "type": "integer",
          "minimum": 50,
          "maximum": 400,
          "description": "JP to learn it (§12.1: actives 50–400)"
        },
        "later": {
          "type": "boolean",
          "description": "Learnable, but it does nothing in battle until its system exists"
        },
        "mp": {
          "type": "integer",
          "minimum": 0
        },
        "tp": {
          "type": "integer",
          "minimum": 0
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "hitsMax": {
          "type": "integer",
          "minimum": 2,
          "maximum": 10
        },
        "vs": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "execute": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "below"
          ],
          "properties": {
            "below": {
              "type": "number"
            },
            "pct": {
              "type": "number"
            },
            "kills": {
              "type": "boolean"
            }
          }
        },
        "powerIfAllyDown": {
          "type": "number"
        },
        "powerIfMarked": {
          "type": "number"
        },
        "refundTp": {
          "type": "integer",
          "minimum": 0
        },
        "dispel": {
          "type": "array",
          "items": {
            "$ref": "defs.schema.json#/definitions/id"
          }
        },
        "restore": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "hpPct": {
              "type": "number"
            },
            "durPct": {
              "type": "number"
            },
            "loc": {
              "enum": [
                "random",
                "lowest",
                "all"
              ]
            }
          }
        },
        "cure": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sanityPct": {
          "type": "number"
        },
        "tpGrant": {
          "type": "integer"
        },
        "revive": {
          "type": "number"
        },
        "self": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tp": {
              "type": "integer"
            },
            "statuses": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "ticks"
                ],
                "properties": {
                  "id": {
                    "$ref": "defs.schema.json#/definitions/id"
                  },
                  "ticks": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "value": {
                    "type": "number"
                  },
                  "mods": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "number"
                    }
                  }
                }
              }
            },
            "mods": {
              "type": "object",
              "additionalProperties": {
                "type": "number"
              },
              "description": "Added to the user's mods (turn.* ones end at its next turn)"
            }
          }
        },
        "flag": {
          "type": "string",
          "description": "A one-use flag given to each target"
        },
        "dice": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "scale": {
              "type": "number"
            },
            "restorePct": {
              "type": "number"
            },
            "high": {
              "type": "number"
            },
            "highPower": {
              "type": "number"
            },
            "low": {
              "type": "number"
            },
            "lowPower": {
              "type": "number"
            },
            "otherwise": {
              "type": "number"
            },
            "lowHitsSelf": {
              "type": "boolean"
            },
            "doubleDown": {
              "type": "boolean"
            }
          }
        },
        "song": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "layer",
            "mods"
          ],
          "properties": {
            "layer": {
              "enum": [
                "melody",
                "harmony",
                "chorus"
              ]
            },
            "mods": {
              "type": "object",
              "additionalProperties": {
                "type": "number"
              }
            }
          }
        },
        "move": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tag"
          ],
          "properties": {
            "tag": {
              "type": "string"
            },
            "finisher": {
              "type": "string",
              "pattern": "^([a-z]+(,[a-z]+)*|distinct:[0-9])$"
            }
          }
        },
        "tpOnHit": {
          "type": "integer",
          "minimum": 0
        },
        "bigPct": {
          "type": "number"
        },
        "split": {
          "type": "boolean"
        },
        "hpCost": {
          "type": "integer",
          "minimum": 1,
          "maximum": 90,
          "description": "% of max HP paid instead of TP (Blood Price)"
        },
        "drain": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "description": "% of damage dealt returned as HP"
        },
        "critIfMarked": {
          "type": "boolean"
        },
        "critFirstTurn": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "description": "Crit chance + on the user's first turn of the battle"
        },
        "breaksCharge": {
          "type": "boolean",
          "description": "Cancels the target's charge in progress, bosses' too"
        },
        "shieldPct": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "description": "A Shield of this % of each target's max HP"
        },
        "dispelBuffs": {
          "type": "integer",
          "minimum": 1,
          "description": "Buffs removed from each target (99: all)"
        },
        "summon": {
          "$ref": "defs.schema.json#/definitions/id",
          "description": "A summon id from summons.json (§12.15)"
        },
        "sacrifice": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "description": "Dismisses one of the user's summons; allies around it heal this % of max HP"
        },
        "banish": {
          "type": "boolean",
          "description": "Removes an enemy summon or add"
        },
        "interpose": {
          "type": "boolean",
          "description": "Until the user's next turn, foes' hits on the target strike the user instead (Interpose)"
        },
        "swap": {
          "type": "boolean",
          "description": "The user and the target, an ally in the user's row, swap places (Rescue)"
        },
        "parts": {
          "type": "array",
          "items": {
            "enum": [
              "spring",
              "gear",
              "powder",
              "lens",
              "wire",
              "vial",
              "plate",
              "core"
            ]
          },
          "description": "Tinkerer Components it uses up (§12.2)"
        },
        "lens": {
          "type": "boolean",
          "description": "Uses a held Lens, if any, to never miss (Bolt)"
        },
        "pull": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2,
          "description": "Columns the target is pulled toward the gap"
        },
        "ctGrant": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "description": "CT given to each target"
        },
        "constructHpPct": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "description": "HP restored to a construct target, % of its max"
        },
        "form": {
          "$ref": "defs.schema.json#/definitions/id",
          "description": "Shifts into a Form from forms.json (§12.17)"
        },
        "revert": {
          "type": "boolean",
          "description": "Ends the user's Form"
        },
        "graft": {
          "type": "boolean",
          "description": "Gives the target the user's Form passive"
        }
      }
    },
    "passive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "points",
        "jp",
        "text"
      ],
      "properties": {
        "id": {
          "$ref": "defs.schema.json#/definitions/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "points": {
          "enum": [
            1,
            2,
            3
          ],
          "description": "Passive budget cost (§12.1)"
        },
        "jp": {
          "type": "integer",
          "minimum": 100,
          "maximum": 300
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "mods": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "later": {
          "type": "boolean"
        }
      }
    }
  }
}
