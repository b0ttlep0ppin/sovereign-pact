{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Heraldry: the House color palette and the emblem designer's parts (SPEC §5.1, §5.4)",
  "type": "object",
  "additionalProperties": false,
  "required": ["palette", "shields", "divisions", "metals", "charges"],
  "properties": {
    "palette": {
      "type": "array",
      "minItems": 24,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "hex"],
        "properties": {
          "id": { "$ref": "defs.schema.json#/definitions/id" },
          "name": { "type": "string", "minLength": 1 },
          "hex": { "$ref": "defs.schema.json#/definitions/hex" }
        }
      }
    },
    "shields": { "type": "array", "minItems": 6, "uniqueItems": true, "items": { "$ref": "defs.schema.json#/definitions/id" } },
    "divisions": { "type": "array", "minItems": 12, "uniqueItems": true, "items": { "$ref": "defs.schema.json#/definitions/id" } },
    "metals": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "defs.schema.json#/definitions/id" } },
    "charges": { "type": "array", "minItems": 40, "uniqueItems": true, "items": { "$ref": "defs.schema.json#/definitions/id" } }
  }
}
