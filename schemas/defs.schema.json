{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "defs.schema.json",
  "title": "Shared definitions for content schemas",
  "definitions": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "maxLength": 40,
      "description": "A content id: lower snake case. Saves store ids, never text (SPEC §4.4)."
    },
    "hex": { "type": "string", "pattern": "^#[0-9a-f]{6}$" },
    "names": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 24 } }
  }
}
