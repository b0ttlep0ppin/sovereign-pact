{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Seats: the look of a House's home, purely cosmetic (SPEC §5.5)",
  "type": "object",
  "additionalProperties": false,
  "required": ["seats"],
  "properties": {
    "seats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "flavor"],
        "properties": {
          "id": { "$ref": "defs.schema.json#/definitions/id" },
          "name": { "type": "string", "minLength": 1 },
          "flavor": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
