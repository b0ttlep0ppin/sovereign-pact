{
  "name": "sovereign-pact",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The Sovereign Pact: a co-op dark-fantasy noble-house tactics game for 1-4 players.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.shared.json",
    "lint": "eslint .",
    "sim": "node tools/sim.ts",
    "content": "vitest run tools/content.test.ts",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "ajv": "^8.20.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "29.1.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
