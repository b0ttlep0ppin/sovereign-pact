  "title": "The Mold in the Granary",
  "text": "Black mold blooms in the poorest House's granary, in patterns. The granary cats will not go in. The mold has begun to grow toward the house.",
  "rule": "least_grain",
  "options": [
    {
      "id": "burn",
      "label": "Burn the stock.",
      "tags": [
        "cautious"
      ],
      "outcomes": [
        {
          "w": 100,
          "text": "The stock burns with a smell like singed hair. The mold is gone, and so is the grain.",
          "effects": [
            {
              "resources": {
                "grain": -15
              }
            }
          ]
        }
      ]
    },
    {
      "id": "scrape",
      "label": "Scrape what can be saved.",
      "tags": [
        "clever"
      ],
      "outcomes": [
        {
          "w": 60,
          "text": "Most of it is saved. The scrapers' hands are black for a month.",
          "effects": [
            {
              "resources": {
                "grain": -5
              }
            }
          ]
        },
        {
          "w": 40,
          "text": "The mold comes back, worse, in the shape of handprints.",
          "effects": [
            {
              "resources": {
                "grain": -20
              }
            }
          ]
        }
      ]
    },
    {
      "id": "ignore",
      "label": "Ignore it.",
      "tags": [
        "reckless"
      ],
      "outcomes": [
        {
          "w": 40,
          "text": "It dies off in the cold, curled like something that was listening.",
          "effects": []
        },
        {
          "w": 60,
          "text": "It spreads to next Year's seed. The bread from it tastes of cellars.",
          "effects": [
            {
              "resources": {
                "grain": -25
              }
            }
          ]
        }
      ]
    }
  ]
