  "title": "The Shy Ghost",
  "text": "A small ghost follows the party at a distance, a pale shape no bigger than a child, ducking behind trees whenever anyone looks. At night it comes closer. It seems afraid of some of you more than others.",
  "options": [
    {
      "id": "quiet",
      "label": "The one who has hurt the fewest goes to it.",
      "rule": "scion:fewest_kills|scion:random",
      "tags": [
        "kind"
      ],
      "outcomes": [
        {
          "w": 100,
          "text": "It comes close, and gives them something it was keeping.",
          "effects": [
            {
              "item": {
                "tier": 2
              }
            },
            {
              "sanity": 5
            }
          ]
        }
      ]
    },
    {
      "id": "chase",
      "label": "Chase it down.",
      "rule": "scion:highest:speed",
      "tags": [
        "reckless"
      ],
      "outcomes": [
        {
          "w": 50,
          "text": "It bursts into cold light.",
          "effects": [
            {
              "to": "party",
              "status": "slow"
            }
          ]
        },
        {
          "w": 50,
          "text": "It flees into a cave and shows you a way through.",
          "effects": [
            {
              "skip": 1
            }
          ]
        }
      ]
    },
    {
      "id": "ignore",
      "label": "Let it follow.",
      "rule": "vote",
      "tags": [
        "cautious"
      ],
      "outcomes": [
        {
          "w": 100,
          "text": "It follows for a while and then is gone. In the morning everyone's boots have been cleaned and their buckles mended.",
          "effects": [
            {
              "to": "party",
              "durability": 10
            }
          ]
        }
      ]
    }
  ]
