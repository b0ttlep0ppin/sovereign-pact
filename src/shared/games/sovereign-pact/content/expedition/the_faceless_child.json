            {
              "to": "party",
              "sanity": -4
            }
          ]
        }
      ]
    },
    {
      "id": "shoo",
      "label": "Shoo it away.",
      "rule": "leader",
      "tags": [
        "cruel"
      ],
      "outcomes": [
