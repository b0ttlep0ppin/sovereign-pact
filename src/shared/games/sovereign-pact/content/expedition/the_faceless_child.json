        "kind"
      ],
      "outcomes": [
        {
          "w": 100,
          "text": "The child smiles with the drawn mouth, and leads you out.",
          "effects": [
            {
              "skip": 1
            },
            {
              "sanity": 8
            }
          ]
        }
      ]
    },
    {
