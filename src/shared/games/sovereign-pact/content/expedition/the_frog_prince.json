  "title": "The Frog Prince",
  "text": "A frog the size of a cat sits on a lily pad wearing a tiny crown, its throat swelling as it speaks. He begs to be kissed, very politely, with great dignity. He was a prince of the Drowned Marches once, he says, before he said something to the wrong witch.",
  "options": [
    {
      "id": "kiss",
      "label": "The kindest kisses him.",
      "rule": "scion:most_healing|scion:random",
      "tags": [
        "kind"
      ],
      "outcomes": [
        {
          "w": 40,
          "text": "A prince, wet and grateful and naked. His House will remember.",
          "effects": [
            {
              "score": {
                "renown": 2
              }
            },
            {
              "resources": {
                "gold": 20
              }
            }
          ]
        },
        {
          "w": 60,
          "text": "Still a frog. A poisonous one.",
          "effects": [
            {
              "status": "poison"
            }
          ]
        }
      ]
    },
    {
      "id": "crown",
      "label": "Take his tiny crown.",
      "rule": "leader",
      "tags": [
        "cruel"
      ],
      "outcomes": [
        {
          "w": 100,
          "text": "Real gold, and a very angry frog, who knows a witch.",
          "effects": [
            {
              "resources": {
                "gold": 15
              }
            },
            {
              "doom": 1
            }
          ]
        }
      ]
    },
    {
      "id": "pass",
      "label": "Wish him luck, and go.",
      "rule": "vote",
      "tags": [
        "cautious"
      ],
      "outcomes": [
        {
          "w": 100,
          "text": "He croaks after you, a very small curse, and that night every waterskin in the party tastes of pond.",
          "effects": [
            {
              "to": "party",
              "mp": -10
            }
          ]
        }
      ]
    },
    {
      "id": "kiss_him",
      "label": "The kindly one kisses him.",
      "rule": "scion:trait:kindly",
      "only": true,
      "tags": [
        "kind"
      ],
      "outcomes": [
        {
          "w": 50,
          "text": "He is a prince, briefly, long enough to press a ring into their hand, and then a frog again, weeping.",
          "effects": [
            {
              "item": {
                "tier": 2
              }
            }
          ]
        },
        {
          "w": 50,
          "text": "Nothing happens at all, except the taste, which lasts.",
          "effects": [
            {
              "sanity": -5
            }
          ]
        }
      ]
    }
  ]
