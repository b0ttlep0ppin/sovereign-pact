  "title": "The Pilgrim Ghost",
  "text": "The ghost of a pilgrim walks beside you, grey and threadbare, a staff in its faded hand. It died on this road long ago and does not know it. Every few steps it asks, politely, how far it is to the shrine.",
  "options": [
    {
      "id": "tell",
      "label": "Tell it the truth.",
      "rule": "vote",
      "tags": [
        "kind"
      ],
      "outcomes": [
        {
          "w": 100,
          "text": "It weeps, without a sound, and walks on.",
          "effects": [
            {
              "to": "party",
              "sanity": -3
            }
          ]
        }
      ]
    },
    {
      "id": "lie",
      "label": "Tell it the shrine is not far.",
      "rule": "leader",
      "tags": [
        "kind"
      ],
      "outcomes": [
        {
          "w": 100,
          "text": "It smiles, and fades, at peace.",
          "effects": [
            {
              "to": "party",
              "sanity": 5
            },
            {
              "score": {
                "renown": 1
              }
            }
          ]
        }
      ]
    },
    {
      "id": "lead",
      "label": "The devout leads it all the way there.",
      "rule": "scion:trait:devout|scion:highest:sagacity",
      "tags": [
        "kind"
      ],
      "outcomes": [
        {
          "w": 100,
          "text": "At the shrine it blesses them, and is gone.",
          "effects": [
            {
              "blessing": {
                "trait": "stout_hearted",
                "years": 2
              }
            }
          ]
        }
      ]
    }
  ]
