              }
            }
          ]
        }
      ]
    },
    {
      "id": "ask",
      "label": "The wisest asks who is inside.",
      "rule": "scion:highest:sagacity",
      "tags": [
        "clever"
      ],
      "outcomes": [
        {
          "w": 100,
          "text": "A name you know from the House's old debts.",
          "effects": [
            {
              "score": {
                "intrigue": 2
              }
            }
          ]
        }
      ]
    },
    {
      "id": "push",
      "label": "Push it on downstream.",
      "rule": "leader",
      "tags": [
        "cautious"
      ],
      "outcomes": [
        {
          "w": 100,
          "text": "The knocking fades.",
