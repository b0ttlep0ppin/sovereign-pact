      "tags": [
        "reckless",
        "kind"
      ],
      "outcomes": [
        {
          "w": 45,
          "text": "She holds them under, gently, a long time. What climbs out is green and dripping and still knows your names.",
          "effects": [
            {
              "change": "marsh_thing"
            }
          ]
        },
        {
          "w": 35,
          "text": "She kisses their brow and is gone. They come back calmer, holding something she gave them.",
          "effects": [
            {
              "sanity": 30
            },
            {
              "item": {
                "tier": 3
              }
            }
          ]
        },
        {
          "w": 20,
          "text": "She will not let go.",
          "effects": [
            {
              "injury": "body"
            }
          ]
        }
      ]
    },
    {
      "id": "ignore",
      "label": "Walk on, eyes front.",
      "rule": "leader",
      "tags": [
        "cautious"
      ],
      "outcomes": [
        {
          "w": 70,
          "text": "The humming follows you a while and then stops. The Leader does not stop hearing it, and walks into the next fight half in a dream.",
          "effects": [
            {
              "sanity": -6,
              "status": "slow"
            }
          ]
        },
        {
          "w": 30,
          "text": "The humming follows you all day.",
          "effects": [
            {
              "to": "party",
              "sanity": -10
            }
          ]
        }
      ]
