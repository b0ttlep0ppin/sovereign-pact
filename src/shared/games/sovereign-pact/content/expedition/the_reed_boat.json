  "title": "The Reed Boat",
  "text": "A boat of woven reeds is tied at the water's edge, with a paddle laid in it and a note weighted with a stone: take me where you need to go. The handwriting is neat and careful. The ink is still wet.",
  "options": [
    {
      "id": "take",
      "label": "Take the boat.",
      "rule": "vote",
      "tags": [
        "bold"
      ],
      "outcomes": [
        {
          "w": 70,
          "text": "It carries you far, and lets you off gently, and drifts back the way it came.",
          "effects": [
            {
              "skip": 2
            }
          ]
        },
        {
          "w": 30,
          "text": "It carries you somewhere it wanted to go.",
          "effects": [
            {
              "fork": {
                "drop": 1,
                "add": [
                  "encounter"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "id": "read",
      "label": "The wisest reads the note again.",
      "rule": "scion:highest:sagacity",
      "tags": [
        "clever"
      ],
      "outcomes": [
        {
          "w": 100,
          "text": "Written in a drowned woman's hand. You leave the boat where it is.",
          "effects": [
            {
              "score": {
                "lore": 1
              }
            }
          ]
        }
      ]
    },
    {
      "id": "burn",
      "label": "Burn the boat.",
      "rule": "leader",
      "tags": [
        "cautious"
      ],
      "outcomes": [
        {
          "w": 100,
          "text": "Something in the water screams, and does not follow.",
          "effects": [
            {
              "to": "party",
              "sanity": -5
            },
            {
              "doom": -1
            }
          ]
        }
      ]
    }
  ]
