{
  "id": "the_witch_hut",
  "pools": [
    "hollow_wood"
  ],
  "weight": 2,
  "band": [
    1,
    7
  ],
  "title": "The Witch's Hut",
  "text": "A hut on chicken legs scratches in the leaves. The witch inside offers a trade: a year of your life for a cure.",
  "options": [
    {
      "id": "trade",
      "label": "The most wounded trades.",
      "rule": "scion:injured:any|scion:lowest:sanity",
      "tags": [
        "reckless"
      ],
      "outcomes": [
        {
          "w": 100,
          "text": "The wound closes. They feel older.",
          "effects": [
            {
              "mend": true
            },
            {
              "stat": {
                "speed": -1
              }
            }
          ]
        }
      ]
    },
    {
      "id": "haggle",
      "label": "The shrewdest haggles her down.",
      "rule": "scion:highest:guile",
      "tags": [
        "clever"
      ],
      "outcomes": [
        {
          "w": 60,
          "text": "A month instead of a year.",
          "effects": [
            {
              "to": "party",
              "status": "regen"
            }
          ]
        },
        {
          "w": 40,
          "text": "She is insulted.",
          "effects": [
            {
              "curse": true
            }
          ]
        }
      ]
    },
    {
      "id": "leave",
      "label": "Leave her be.",
      "rule": "vote",
      "tags": [
        "cautious"
      ],
      "outcomes": [
        {
          "w": 50,
          "text": "The hut follows a while, then loses interest. Where its claws scratched the path it left a bundle of good herbs.",
          "effects": [
            {
              "to": "party",
              "hp": 10
            }
          ]
        },
        {
          "w": 50,
          "text": "The hut follows a while, then loses interest, and the witch leans out and spits after you.",
          "effects": [
            {
              "to": "party",
              "status": "disease"
            }
          ]
        }
      ]
    },
    {
      "id": "witch_to_witch",
      "label": "The one in a hood haggles with her, witch to witch.",
      "rule": "scion:wears:hood",
      "only": true,
      "tags": [
        "clever"
      ],
      "outcomes": [
        {
          "w": 100,
          "text": "She cackles, and takes a lock of hair instead of a year, and the cure is real.",
          "effects": [
            {
              "mend": true,
              "sanity": -5
            }
          ]
        }
      ]
    }
  ]
}
