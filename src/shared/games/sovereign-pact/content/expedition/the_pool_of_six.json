  "title": "The Pool of Six",
  "text": "A still pool at the Shrine, ringed with six pale stones. It shows each person who looks into it the god who favors them, a face rising up out of the dark. Some see nothing at all, and walk away very quiet.",
  "options": [
    {
      "id": "look",
      "label": "Each Scion looks into the pool.",
      "rule": "vote",
      "tags": [
        "bold"
      ],
      "outcomes": [
        {
          "w": 60,
          "text": "A god looks back.",
          "effects": [
            {
              "to": "party",
              "sanity": 10
            }
          ]
        },
        {
          "w": 40,
          "text": "Nothing. Only dark water, and your own face, alone.",
          "effects": [
            {
              "to": "party",
              "sanity": -10
            }
          ]
        }
      ]
    },
    {
      "id": "devout",
      "label": "The devout drinks from the pool.",
      "rule": "scion:trait:devout|scion:highest:sagacity",
      "tags": [
        "kind"
      ],
      "outcomes": [
        {
          "w": 100,
          "text": "A blessing, and it will last for years.",
          "effects": [
            {
              "blessing": {
                "trait": "stout_hearted",
                "years": 3
              }
            }
          ]
        }
      ]
    },
    {
      "id": "pass",
      "label": "Do not look.",
      "rule": "vote",
      "tags": [
        "cautious"
      ],
      "outcomes": [
        {
          "w": 100,
          "text": "Some things are better not known. Walking on, you all feel that somewhere, someone approves.",
          "effects": [
            {
              "to": "party",
              "sanity": 5
            }
          ]
        }
      ]
    }
  ]
