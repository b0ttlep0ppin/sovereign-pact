      "outcomes": [
        {
          "w": 80,
          "text": "A cold, safe night, and his heart beats slow in the dark.",
          "effects": [
            {
              "to": "party",
              "sanity": 5
            }
          ]
        },
        {
          "w": 20,
          "text": "Colder than you thought. By morning, a little of the ice is in you too.",
          "effects": [
            {
              "to": "party",
              "status": "frozen"
            }
          ]
        }
      ]
    },
    {
      "id": "ask",
      "label": "The wisest asks how he became so.",
      "rule": "scion:highest:sagacity",
      "tags": [
