      "label": "Push on through the storm.",
      "rule": "leader",
      "tags": [
        "bold"
      ],
      "outcomes": [
        {
          "w": 100,
          "text": "Through, and frostbitten, and toes that will not warm for days.",
          "effects": [
            {
              "to": "party",
