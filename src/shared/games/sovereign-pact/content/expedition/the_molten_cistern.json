      "label": "Fish out ingots with a pole.",
      "rule": "vote",
      "tags": [
        "clever"
      ],
      "outcomes": [
        {
          "w": 70,
          "text": "A good haul, still smoking.",
          "effects": [
            {
              "resources": {
                "iron": 6
              }
            }
          ]
        },
        {
          "w": 30,
          "text": "The pole catches fire, then a sleeve, then the next sleeve.",
          "effects": [
            {
              "to": "party",
              "status": "burn"
            }
          ]
        }
      ]
    },
    {
      "id": "reach",
      "label": "The quickest reaches for the best ingot.",
      "rule": "scion:highest:speed",
      "tags": [
        "reckless"
      ],
      "outcomes": [
        {
          "w": 50,
          "text": "Star iron, and they pull back before the heat bites.",
          "effects": [
            {
              "resources": {
                "iron": 4,
                "essence": 3
              }
            }
          ]
        },
        {
          "w": 50,
          "text": "They have it, and then the heat has them.",
          "effects": [
            {
              "durability": -25,
              "loc": "arms"
            }
          ]
        }
      ]
    },
    {
      "id": "leave",
