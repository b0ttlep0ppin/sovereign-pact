      "rule": "leader",
      "tags": [
        "cautious"
      ],
      "outcomes": [
        {
          "w": 100,
          "text": "It bubbles at you, and one bubble bursts across the Leader's sleeve.",
          "effects": [
            {
              "hp": -10,
              "durability": -20,
              "loc": "arms"
            }
          ]
        }
      ]
    },
    {
      "id": "wade_in",
