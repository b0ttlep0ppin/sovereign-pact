      "label": "The bravest rides away with her.",
      "rule": "scion:trait:brave|scion:highest:resilience",
      "tags": [
        "reckless"
      ],
      "outcomes": [
        {
          "w": 60,
          "text": "They come back with a sliver of her mirror, and a cold heart that does not thaw.",
          "effects": [
            {
              "item": {
                "tier": 3
              }
            },
            {
              "sanity": -15
            }
          ]
        },
        {
          "w": 40,
          "text": "They come back with frostbite, and nothing else, and will not say what they saw.",
          "effects": [
            {
              "injury": "arms"
            }
          ]
        }
      ]
    },
    {
      "id": "decline",
      "label": "Decline her, politely.",
      "rule": "vote",
      "tags": [
        "cautious"
      ],
      "outcomes": [
        {
          "w": 50,
          "text": "She laughs and is gone. Her wolves stay, keeping pace at the edge of sight.",
          "effects": [
            {
              "fork": {
