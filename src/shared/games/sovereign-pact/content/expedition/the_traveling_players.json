      "rule": "house:highest_standing",
      "tags": [
        "cruel"
      ],
      "outcomes": [
        {
          "w": 100,
          "text": "They take the coin and the note gladly.",
          "effects": [
            {
              "resources": {
                "gold": -10
              }
            },
            {
