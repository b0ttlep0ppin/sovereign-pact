  "title": "The Doppelganger",
  "text": "At dawn there is one Scion too many in camp. Two of them sit by the fire, the same face, the same scars, the same way of holding a cup. Both of them swear they are the real one. Both of them are frightened, or both of them are very good at it.",
  "options": [
    {
      "id": "ask",
      "label": "The sharpest asks questions only the real one could answer.",
      "rule": "scion:highest:acuity",
      "tags": [
        "clever"
      ],
      "outcomes": [
        {
          "w": 70,
          "text": "The false one fumbles a childhood name, and runs.",
          "effects": [
            {
              "score": {
                "intrigue": 1
              }
            },
            {
              "xp": 60
            }
          ]
        },
        {
          "w": 30,
          "text": "Both answer perfectly.",
          "effects": [
            {
              "encounter": {
                "modifier": "ambush"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "both",
      "label": "Keep both until one gives itself away.",
      "rule": "vote",
      "tags": [
        "reckless"
      ],
      "outcomes": [
        {
          "w": 100,
          "text": "It gives itself away at the worst moment.",
          "effects": [
            {
              "encounter": {
                "modifier": "ambush"
              }
            },
            {
              "to": "party",
              "sanity": -5
            }
          ]
        }
      ]
    },
    {
      "id": "test",
      "label": "Test them both with silver.",
      "rule": "leader",
      "tags": [
        "bold"
      ],
      "outcomes": [
        {
          "w": 100,
          "text": "Silver burns one of them.",
          "effects": [
            {
              "encounter": {
                "modifier": "surprise"
              }
            }
          ]
        }
      ]
    }
  ]
