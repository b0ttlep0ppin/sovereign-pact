  "gambits": [
    {"if": "turn%3==0", "do": "blossom_storm", "target": "densest_row"},
    {"if": "hp<0.8 && turn%4==1", "do": "fertile_ground"},
    {"do": "thorned_embrace", "target": "nearest"}
