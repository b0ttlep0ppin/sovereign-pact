  "abilities": [
    {"id": "thorned_embrace", "shape": "single", "side": "player", "power": 1.0, "statuses": [{"id": "rooted", "chance": 50, "ticks": 200}, {"id": "bleed", "chance": 30, "ticks": 300}]},
    {"id": "blossom_storm", "shape": "band:3", "side": "player", "power": 0.7, "kind": "magic", "element": "earth", "charge": 200, "telegraph": true, "cooldown": 3, "statuses": [{"id": "sleep", "chance": 30, "ticks": 200}]},
    {"id": "fertile_ground", "shape": "self", "side": "self", "power": 0, "kind": "support", "statuses": [{"id": "regen", "chance": 100, "ticks": 400}], "cooldown": 4}
