    {"id": "lullaby", "shape": "all", "side": "player", "power": 0, "kind": "support", "charge": 120, "telegraph": true, "cooldown": 4, "sanityResists": true, "statuses": [{"id": "sleep", "chance": 100, "ticks": 300}]},
    {"id": "consume", "shape": "self", "side": "self", "power": 0, "kind": "support", "cooldown": 3, "devour": {"of": ["void_unknown_seed"], "healPct": 10, "all": true}},
    {"id": "rupture_a", "shape": "checker:a", "side": "player", "power": 1.0, "kind": "magic", "element": "dark", "sanity": 3},
