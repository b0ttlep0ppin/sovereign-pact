    {"id": "tide_pour", "shape": "band:3", "side": "player", "power": 0.9, "kind": "magic", "element": "water", "charge": 200, "telegraph": true, "cooldown": 3},
    {"id": "the_mixing", "shape": "self", "side": "self", "power": 0, "kind": "support", "statuses": [{"id": "regen", "chance": 100, "ticks": 400}, {"id": "shell", "chance": 100, "ticks": 300}], "cooldown": 4},
